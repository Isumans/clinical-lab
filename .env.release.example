BACKEND_IMAGE=ghcr.io/isumans/labsync-backend:0.3.0
FRONTEND_IMAGE=ghcr.io/isumans/labsync-frontend:0.3.0
LABSYNC_APP_VERSION=0.3.0

POSTGRES_DB=labsync
POSTGRES_USER=labsync
POSTGRES_PASSWORD=replace_with_the_existing_url_safe_database_password
POSTGRES_PORT=5433

LABSYNC_DATABASE_URL=postgresql+psycopg://labsync:replace_with_the_existing_url_safe_database_password@db:5432/labsync
LABSYNC_JWT_SECRET_KEY=replace_with_the_existing_long_random_secret
LABSYNC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

BACKEND_PORT=8000
FRONTEND_PORT=3000
