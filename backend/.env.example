LABSYNC_APP_NAME=LabSync API
LABSYNC_APP_VERSION=0.1.0
LABSYNC_DEBUG=false
LABSYNC_DATABASE_URL=postgresql+psycopg://labsync:replace_with_your_password@localhost:5432/labsync
LABSYNC_JWT_SECRET_KEY=replace_with_a_long_random_secret
LABSYNC_JWT_ALGORITHM=HS256
LABSYNC_ACCESS_TOKEN_EXPIRE_MINUTES=30
LABSYNC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
